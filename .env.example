# Environment Mode: 'cloud' or 'docker_onprem'
SUPABASE_ENV=cloud

# Supabase Credentials (Cloud or Docker Local)
# For Cloud: https://<project-ref>.supabase.co
# For Docker Local: http://localhost:8000 (or http://supabase-kong:8000)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Asymmetric Key System (ECC P-256 / ES256) - Recommended for Modern Supabase
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Direct Postgres Connection URL
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD_HERE@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Application Config
PROJECT_NAME="RoSense AI Backend API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:3030","https://rosenseai.vercel.app"]
